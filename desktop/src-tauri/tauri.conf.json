{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "órama",
  "mainBinaryName": "orama",
  "version": "0.2.0",
  "identifier": "com.dounindustries.orama",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "copyright": "Doun Industries. Based on Odysseus. AGPL-3.0-or-later.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/engine/": "engine/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
